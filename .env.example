# Firebase Configuration
# Copy this file to .env and fill in your actual Firebase project values.
# Get these values from Firebase Console > Project Settings > Your Apps > Web app > Config
# NEVER commit your actual .env file to version control.

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps (optional — used for interactive map)
# Get from Google Cloud Console > APIs & Services > Credentials
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# App Mode: set to "demo" to run without Firebase, "live" to use real Firebase
VITE_APP_MODE=demo
